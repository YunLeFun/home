{
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "nuxt build",
    "audit:prod": "pnpm audit --prod",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm audit:prod",
    "deploy": "pnpm build && wrangler deploy",
    "dev": "nuxt dev",
    "dev:pwa": "VITE_PLUGIN_PWA=true nuxt dev",
    "preview": "nuxt preview",
    "test": "vitest run",
    "typecheck": "nuxt prepare && vue-tsc -b --noEmit",
    "lint": "eslint .",
    "postinstall": "nuxt prepare",
    "generate": "nuxt generate"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "^3.6.2",
    "@nuxtjs/color-mode": "^4.0.1",
    "@pinia/nuxt": "^1.0.0",
    "@unocss/nuxt": "^66.7.5",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/nuxt": "^14.3.0",
    "nuxt": "^4.4.8",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.24",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/twemoji": "^1.2.5",
    "@nuxt/eslint": "^1.16.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.7.0",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "unocss": "^66.7.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7",
    "wrangler": "^4.111.0"
  }
}
