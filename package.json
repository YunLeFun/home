{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "nuxt build",
    "audit:prod": "pnpm audit --prod",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm audit:prod",
    "deploy": "pnpm build && wrangler deploy",
    "dev": "nuxt dev",
    "dev:pwa": "VITE_PLUGIN_PWA=true nuxt dev",
    "preview": "nuxt preview",
    "test": "vitest run",
    "typecheck": "nuxt prepare && vue-tsc -b --noEmit",
    "lint": "eslint .",
    "postinstall": "nuxt prepare",
    "generate": "nuxt generate"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "^3.10.2",
    "@nuxtjs/color-mode": "^4.0.1",
    "@pinia/nuxt": "^1.0.3",
    "@unocss/nuxt": "^66.11.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/nuxt": "^15.0.0",
    "@yunlefun-home/air-conditioner": "^0.3.0",
    "@yunlefun-home/air-conditioner-core": "^0.3.0",
    "@yunlefun/sso": "^0.6.2",
    "home-assistant-js-websocket": "^9.7.1",
    "nuxt": "^4.6.1",
    "pinia": "^4.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.28",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/twemoji": "^1.2.5",
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "oxc-parser": "^0.154.0",
    "sass": "^1.105.1",
    "typescript": "^6.0.3",
    "unocss": "^66.11.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.0"
  }
}
