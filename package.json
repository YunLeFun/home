{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "ha:up": "bash scripts/home-assistant.sh up",
    "ha:stop": "bash scripts/home-assistant.sh stop",
    "ha:status": "bash scripts/home-assistant.sh status",
    "ha:logs": "bash scripts/home-assistant.sh logs",
    "ha:xiaomi:install": "bash scripts/install-xiaomi-home.sh",
    "device-kit:test": "swift test",
    "macos:dev": "swift run --package-path apps/macos YunHome",
    "macos:test": "swift test --package-path apps/macos",
    "macos:build": "bash apps/macos/scripts/bundle.sh",
    "build": "nuxt build",
    "audit:prod": "pnpm audit --prod",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm audit:prod",
    "deploy": "pnpm build && wrangler deploy",
    "dev": "nuxt dev",
    "dev:pwa": "VITE_PLUGIN_PWA=true nuxt dev",
    "preview": "nuxt preview",
    "test": "vitest run",
    "typecheck": "nuxt prepare && vue-tsc -b --noEmit",
    "lint": "eslint .",
    "postinstall": "nuxt prepare",
    "generate": "nuxt generate",
    "scene:posters": "node scripts/export-scene-posters.mjs"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "^3.10.2",
    "@nuxtjs/color-mode": "^4.0.1",
    "@pinia/nuxt": "^1.0.3",
    "@unocss/nuxt": "^66.11.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/nuxt": "^15.0.0",
    "@yunlefun-home/air-conditioner": "^0.3.0",
    "@yunlefun-home/air-conditioner-core": "^0.3.0",
    "@yunlefun/sso": "^0.6.2",
    "@yunlefun/ui": "^0.0.7",
    "home-assistant-js-websocket": "^9.7.1",
    "nuxt": "^4.6.1",
    "pinia": "^4.1.0",
    "three": "^0.186.1",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.28",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/twemoji": "^1.2.5",
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "oxc-parser": "^0.154.0",
    "playwright-core": "^1.64.1",
    "sass": "^1.105.2",
    "typescript": "^6.0.3",
    "unocss": "^66.11.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.1"
  }
}
